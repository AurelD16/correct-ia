# Copier en `.env.local` et compléter.
# Le fichier `.env` / `.env.local` est gitignoré : ne jamais commiter de secrets.

# URL de base compatible OpenAI (se terminant généralement par /v1).
LLM_BASE_URL=https://api.openai.com/v1

# Clé d'API — JAMAIS exposée au navigateur.
LLM_API_KEY=

# Identifiant du modèle.
LLM_MODEL=gpt-4o-mini

# Langue de travail du correcteur et langue par défaut de l'interface.
LLM_LANGUAGE=fr

# Paramètres de génération.
LLM_TEMPERATURE=0
LLM_TIMEOUT_MS=60000

# Longueur maximale du texte soumis (au-delà : refus 400, jamais de troncature).
# Lue côté serveur : l'interface compteur / alerte à 80 % / blocage de soumission
# suit exactement cette valeur, à la hausse comme à la baisse.
LLM_MAX_INPUT_CHARS=8000

# true  -> response_format json_schema strict (si supporté par l'hôte)
# false -> response_format json_object (repli automatique sur erreur 400 amont)
LLM_STRUCTURED_OUTPUT=true

# Ne jamais passer à true en production : journalise le texte utilisateur.
LOG_TEXT=false
